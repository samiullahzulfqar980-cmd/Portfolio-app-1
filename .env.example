# -----------------------------------------------------------------------------
# Portfolio app environment
#
# 1. Copy this file:            cp .env.example .env
# 2. Fill in the two values from your Supabase project:
#    Dashboard -> Project Settings -> API
# 3. Run / build with:          flutter run --dart-define-from-file=.env
#
# ONLY the public "anon" / "publishable" key belongs in a mobile app.
# NEVER put the service_role / secret key in this file or anywhere in lib/.
# .env is git-ignored; .env.example (this file) only carries placeholders.
# -----------------------------------------------------------------------------

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional: custom URL scheme used for password-reset / email-confirmation
# deep links. Must match android/app/src/main/AndroidManifest.xml and
# ios/Runner/Info.plist (see README).
APP_URL_SCHEME=portfolioapp

# -----------------------------------------------------------------------------
# Optional: used only by the maintenance scripts in scripts/ (never required by
# the app itself). Export them in your shell before running
# `python3 scripts/supabase_media.py ...` to move bundled media into Storage.
#
#   SUPABASE_ADMIN_EMAIL=you@example.com      # must exist in public.admin_users
#   SUPABASE_ADMIN_PASSWORD=...               # never commit a real password
#
# The scripts read SUPABASE_URL / SUPABASE_ANON_KEY from the values above.
# -----------------------------------------------------------------------------
